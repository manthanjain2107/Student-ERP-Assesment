# Application settings
APP_NAME=School ERP - Student Management API
APP_VERSION=1.0.0
ENVIRONMENT=development

# Database connection (MySQL 8.0 default via PyMySQL)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>?charset=utf8mb4
# Note: URL-encode special characters in passwords (for example, @ -> %40)
DATABASE_URL=mysql+pymysql://root:your_password_here@localhost:3306/school_erp?charset=utf8mb4

# Optional: Set to true to log SQL queries in development
DB_ECHO=false

# Comma-separated allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
